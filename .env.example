# Broker MQTT untuk browser harus memakai WebSocket Secure (WSS port 8884),
# bukan port TCP 1883. Minta kredensial cluster HiveMQ Cloud Anda sendiri.
VITE_MQTT_URL=wss://<your-hivemq-cluster>.s1.eu.hivemq.cloud:8884/mqtt
VITE_MQTT_USERNAME=<mqtt-username>
VITE_MQTT_PASSWORD=<mqtt-password>

# Endpoint MJPEG Gateway. Gunakan path relatif "/video_feed" di produksi
# agar lolos mixed-content HTTPS via Nginx reverse proxy.
VITE_RTSP_MJPEG_URL=/video_feed

# Tanggal mulai batch aktif (format ISO lokal).
VITE_INKUBASI_START=2026-06-02T07:00:00

# Kode akses demo mode Admin dan Operator (frontend-only, untuk demo).
# Catatan: untuk produksi, verifikasi role wajib diproses di backend (JWT),
# bukan hanya mengandalkan kode ini.
VITE_ADMIN_ACCESS_CODE=<admin-code>
VITE_OPERATOR_ACCESS_CODE=<operator-code>

# URL REST API Backend FastAPI/MySQL.
# Kosongkan untuk fallback offline localStorage, atau isi dengan domain API.
# Contoh dev via proxy Vite: biarkan sesuai vite.config.js.
VITE_API_BASE_URL=https://api-merak.abdulrosyid.my.id

# API Key web (wajib, dicocokkan dengan API_KEY_WEB di backend).
VITE_API_KEY_WEB=<api-key-web>
