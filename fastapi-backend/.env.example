# === Database MySQL (wajib untuk Docker/produksi) ===
# Contoh lokal: MYSQL_HOST=localhost, MYSQL_USER=root
MYSQL_HOST=<mysql-host>
MYSQL_PORT=3306
MYSQL_DATABASE=kampung_merak
MYSQL_USER=<mysql-user>
MYSQL_PASSWORD=<mysql-password>

# === Client Security Layer: API Key per platform (wajib) ===
# Setiap request wajib header X-API-Key. Buat nilai acak yang panjang,
# bedakan WEB vs ANDROID, dan jangan pernah commit nilai aslinya.
API_KEY_WEB=<api-key-web>
API_KEY_ANDROID=<api-key-android>

# === Auth JWT ===
# Rahasia penandatangan token, minimal 32 karakter acak di produksi.
JWT_SECRET=<jwt-secret-min-32-char>

# === CORS (wajib untuk web) ===
# Daftar origin yang diizinkan, pisahkan dengan koma untuk multiple domain.
CORS_ORIGINS=https://<domain-prod-anda>

# === Seed admin pertama (dibuat otomatis saat startup bila tabel users kosong) ===
FIRST_ADMIN_EMAIL=<admin-email>
FIRST_ADMIN_PASSWORD=<admin-password>

# === Konfigurasi MQTT Broker WebSocket (info untuk frontend) ===
# Minta cluster HiveMQ Cloud Anda sendiri, jangan pakai kredensial contoh.
MQTT_URL=wss://<your-hivemq-cluster>.s1.eu.hivemq.cloud:8884/mqtt
MQTT_USERNAME=<mqtt-username>
MQTT_PASSWORD=<mqtt-password>

# === Storage MinIO/S3 untuk gambar ===
MINIO_ENDPOINT=http://localhost:9005
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>
MINIO_BUCKET=merak-storage
# Opsional: base URL publik bila berbeda dari ENDPOINT/BUCKET (mis. CDN/domain).
# Kosongkan untuk default {MINIO_ENDPOINT}/{MINIO_BUCKET}.
MINIO_PUBLIC_BASE_URL=
# Batas upload (bytes), default 5MB.
MAX_UPLOAD_BYTES=5242880

# === Snapshot CCTV incubator otomatis (tiap 4 jam) ===
CCTV_SNAPSHOT_URL=http://cctv-gateway:5000/snapshot.jpg
CCTV_HEALTH_URL=http://cctv-gateway:5000/health
CCTV_SNAPSHOT_SOURCE=incubator
CCTV_SNAPSHOT_ENABLED=true
