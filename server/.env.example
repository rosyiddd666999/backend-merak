# URL RTSP Kamera Inkubator melalui ESP32 Relay.
# <ip-kamera>: IP lokal kamera (gunakan Static IP / DHCP Reservation).
# <port>: 554 (standar) atau 8554 (sekunder via relay_server.py).
# Contoh Docker: host gateway dari dalam kontainer, bukan IP publik.
INCUBATOR_RTSP_URL=rtsp://<user>:<password>@<ip-kamera>:<port>/V_ENC_000

# URL RTSP Kamera Kandang Merak (opsional, untuk /kandang_feed).
KANDANG_RTSP_URL=rtsp://<user>:<password>@<ip-kamera-kandang>:<port>/stream1
